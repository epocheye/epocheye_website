  "dialogue": {
    "d-carpenter": [
      { "id": "w-carp-1", "speaker": "carpenter", "text": "Careful. Shavings everywhere.", "pace": "steady", "pause_after_ms": 600 },
      { "id": "w-carp-2", "speaker": "carpenter", "text": "You want to know what holds this place up? Teak.", "say": "You want to know what holds this place up? The teak does.", "facts": ["F04"], "pace": "steady", "pause_after_ms": 600 },
      { "id": "w-carp-3", "speaker": "carpenter", "text": "The pillars, the arches, the beams, the ceilings. All wood.", "facts": ["F04"], "pace": "steady", "pause_after_ms": 600 },
      { "beat": "c1-e1" },
      { "id": "w-carp-4", "speaker": "carpenter", "text": "Ask the mason about the rest. Masons always say it is all stone.", "pace": "steady", "pause_after_ms": 400 }
    ],
    "d-mason": [
      { "id": "w-mas-1", "speaker": "mason", "text": "Mind your feet.", "pace": "steady", "pause_after_ms": 600 },
      { "id": "w-mas-2", "speaker": "mason", "text": "Look down. Every pillar stands on a stone base.", "facts": ["F04"], "pace": "steady", "pause_after_ms": 600 },
      { "beat": "c1-e2" },
      { "id": "w-mas-3", "speaker": "mason", "text": "The outer walls? Mud, under the plaster.", "facts": ["F04"], "pace": "steady", "pause_after_ms": 600 },
      { "beat": "c1-e3" },
      { "id": "w-mas-4", "speaker": "mason", "text": "There is a written record of all this. Take the cart, it is a long walk.", "pace": "steady", "pause_after_ms": 400 }
    ]

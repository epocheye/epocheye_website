{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "epocheye.app"
        }
      ],
      "destination": "https://epocheye.com/:path*",
      "statusCode": 308
    }
  ],
  "crons": [
    {
      "path": "/api/cron/rotate-sites",
      "schedule": "30 0 * * *"
    }
  ]
}

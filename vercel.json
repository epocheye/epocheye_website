{
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "epocheye.com"
        }
      ],
      "destination": "https://www.epocheye.com/:path",
      "statusCode": 308
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?epocheye\\.app"
        }
      ],
      "destination": "https://www.epocheye.com/:path*",
      "statusCode": 308
    }
  ],
  "crons": [
    {
      "path": "/api/cron/rotate-sites",
      "schedule": "30 0 * * *"
    }
  ]
}
